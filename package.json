{
  "name": "@lucascouts/claude-agent-tui",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.14.8",
  "description": "Runs the official Claude Code TUI over a PTY and exposes it via ACP, so Claude Code threads render natively in Zed's agent panel. Built for Anthropic's June 2026 billing split (since paused); maintained for upstream parity, not as an active product — see README.",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "claude-agent-tui": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "smoke:live": "node experiments/smoke-live.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "acp",
    "agent-client-protocol",
    "agent",
    "anthropic",
    "zed",
    "tui",
    "typescript"
  ],
  "homepage": "https://github.com/zeo-workspace/claude-agent-tui#readme",
  "bugs": {
    "url": "https://github.com/zeo-workspace/claude-agent-tui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeo-workspace/claude-agent-tui.git"
  },
  "author": "lucascouts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "node-pty": "1.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
